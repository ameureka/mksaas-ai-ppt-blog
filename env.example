# =============================================================================
# Google AdSense 广告配置 / Google AdSense Configuration
# https://www.google.com/adsense/
# =============================================================================
#
# 📋 配置流程 / Configuration Steps:
#   1. 注册 Google AdSense 账号并等待审核通过 / Register & get approved
#   2. 获取 Publisher ID (格式: ca-pub-xxxxxxxxx) / Get Publisher ID
#   3. 在 AdSense 后台创建广告单元获取 Slot ID / Create ad units for Slot IDs
#   4. 将对应的 Slot ID 填入下方配置 / Fill in the Slot IDs below
#
# ⚠️ 注意事项 / Notes:
#   - 开发环境自动启用测试模式 (显示占位符) / Dev env auto-enables test mode
#   - 生产环境需设置 NEXT_PUBLIC_ADSENSE_TEST_MODE=false / Set to false in prod
#   - 没有 Publisher ID 时 AdSense 脚本不会加载 / Script won't load without ID
#
# -----------------------------------------------------------------------------
# 核心开关 / Core Switches
# -----------------------------------------------------------------------------
# 是否启用 AdSense (true/false) / Enable AdSense
NEXT_PUBLIC_ADSENSE_ENABLED="false"
# 测试模式 - 开启后显示占位符而非真实广告 / Test mode - shows placeholders
# 开发环境默认为 true，生产环境应设为 false / Dev: true, Prod: false
NEXT_PUBLIC_ADSENSE_TEST_MODE="false"

# -----------------------------------------------------------------------------
# Publisher ID (发布商 ID)
# 格式 / Format: ca-pub-xxxxxxxxxxxxxxxxx
# 获取位置 / Where to find: AdSense 首页 > 账号信息
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=""

# -----------------------------------------------------------------------------
# 广告位 Slot ID / Ad Unit Slot IDs
# 在 AdSense 后台创建广告单元后获取 / Create ad units in AdSense dashboard
# 格式 / Format: 纯数字 / Numbers only (e.g., 1234567890)
# -----------------------------------------------------------------------------

# 博客文章页横幅广告 / Blog post banner ad (文章顶部/底部)
NEXT_PUBLIC_ADSENSE_BLOG_BANNER=""

# 博客侧边栏广告 / Blog sidebar ad (桌面端侧边栏)
NEXT_PUBLIC_ADSENSE_BLOG_SIDEBAR=""

# 首页横幅广告 / Homepage banner ad (首页展示区)
NEXT_PUBLIC_ADSENSE_HOME_BANNER=""

# 垂直广告 / Vertical ad (PPT 详情页侧边)
NEXT_PUBLIC_ADSENSE_VERTICAL=""

# 视频流外广告 / Outstream video ad
NEXT_PUBLIC_ADSENSE_OUTSTREAM=""

# 多元广告 / Multiplex ad (相关内容推荐样式)
NEXT_PUBLIC_ADSENSE_MULTIPLEX=""

# 锚定广告 / Anchor ad (页面底部固定广告)
NEXT_PUBLIC_ADSENSE_ANCHOR=""

# =============================================================================
# 广告奖励功能配置说明 / Ad Reward Feature Notes
# =============================================================================
# 观看广告奖励功能在 src/config/website.tsx 的 adReward 配置中控制：
# Ad reward feature is configured in src/config/website.tsx under adReward:
#
#   adReward: {
#     enable: true,           // 是否启用观看广告功能 / Enable ad-watch feature
#     creditsPerWatch: 5,     // 每次观看奖励积分 / Credits per watch
#     watchDuration: 30,      // 观看时长 (秒) / Watch duration in seconds
#     dailyLimitPerUser: 10,  // 每用户每日限制 / Daily limit per user
#     dailyLimitPerIP: 20,    // 每 IP 每日限制 / Daily limit per IP
#   }
#
# ⚠️ 注意: 积分发放还需开启 credits.enableCredits = true
# ⚠️ Note: Credit distribution also requires credits.enableCredits = true
# =============================================================================
